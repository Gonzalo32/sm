{
  "manifest_version": 3,
  "name": "ICT Assistant — TradeSea",
  "version": "0.1.0",
  "description": "Visual ICT/SMC market structure assistant for TradeSea platform.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.tradesea.ai/*",
    "https://*.tradesea.ai/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ICT Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.tradesea.ai/*",
        "https://*.tradesea.ai/*"
      ],
      "js": ["content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/pageBridge.js"],
      "matches": ["https://app.tradesea.ai/*", "https://*.tradesea.ai/*"]
    }
  ]
}
